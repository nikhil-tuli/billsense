# Neon connection string (use the pooled endpoint, sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# "deployed" enables scanning, judging and seeding. Leave unset locally for read-only mode.
APP_MODE=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-4
# Optional: USD per 1M tokens, for the "equivalent paid cost" metric
GEMINI_PRICE_IN_PER_M=
GEMINI_PRICE_OUT_PER_M=
MISTRAL_PRICE_IN_PER_M=
MISTRAL_PRICE_OUT_PER_M=
